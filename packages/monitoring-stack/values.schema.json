{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["chartVersion", "chartDigest", "topology"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "namespace": {"type": "string"},
    "argocdNamespace": {"type": "string"},
    "project": {"type": "string"},
    "topology": {"enum": ["central", "local", "client"]},
    "chartVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chartDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remoteWriteUrl": {"type": "string"},
    "lokiPushUrl": {"type": "string"},
    "controlPlaneTargets": {"type": "string"},
    "ephemeralObjectStorage": {"type": "boolean"}
  },
  "additionalProperties": false
}
