{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["chartVersion", "chartDigest", "topology", "org"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "namespace": {"type": "string"},
    "argocdNamespace": {"type": "string"},
    "project": {"type": "string"},
    "topology": {"enum": ["central", "local", "client"]},
    "org": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "chartVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chartDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remoteWriteUrl": {"type": "string"},
    "lokiPushUrl": {"type": "string"},
    "controlPlaneTargets": {"type": "string"},
    "ephemeralObjectStorage": {"type": "boolean"},
    "mimirS3Endpoint": {"type": "string"},
    "mimirS3Region": {"type": "string"},
    "mimirBlocksBucket": {"type": "string", "minLength": 1},
    "mimirAlertmanagerBucket": {"type": "string", "minLength": 1},
    "mimirCredentialsSecret": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "mimirS3ForcePathStyle": {"type": "boolean"},
    "lokiS3Endpoint": {"type": "string"},
    "lokiS3Region": {"type": "string"},
    "lokiChunksBucket": {"type": "string", "minLength": 1},
    "lokiRulerBucket": {"type": "string", "minLength": 1},
    "lokiCredentialsSecret": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "lokiS3ForcePathStyle": {"type": "boolean"}
  },
  "additionalProperties": false
}
